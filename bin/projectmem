#!/usr/bin/env node
/**
 * projectmem — initialize a repo-local project context cache.
 *
 *   projectmem init --repo-root <dir> --repo-key <key> [options]
 *
 * Scope comes from --project/--workspace/--confidentiality-ceiling and the
 * Bridge profile env (LAOS_CHECKPOINT_*).  context.build and memory.search are
 * called against the Core CLI to seed the summary.
 */

import { fileURLToPath } from "node:url";
import path from "node:path";

const __dirname = path.dirname(fileURLToPath(import.meta.url));

function usage() {
  return [
    "usage: projectmem init \\",
    "  --repo-root <dir> --repo-key <key> --component <comp> \\",
    "  --workspace <personal|work> --project <slug> \\",
    "  [--confidentiality-ceiling <level>] [--bridge-profile <name>]",
  ].join("\n");
}

function parseArgs(argv) {
  const out = { command: null, repoRoot: null, repoKey: null, component: null, workspace: null, project: null, confidentialityCeiling: null, bridgeProfile: null };
  for (let i = 0; i < argv.length; i += 1) {
    const arg = argv[i];
    if (arg === "init") out.command = "init";
    else if (arg === "--repo-root") out.repoRoot = argv[++i];
    else if (arg === "--repo-key") out.repoKey = argv[++i];
    else if (arg === "--component") out.component = argv[++i];
    else if (arg === "--workspace") out.workspace = argv[++i];
    else if (arg === "--project") out.project = argv[++i];
    else if (arg === "--confidentiality-ceiling") out.confidentialityCeiling = argv[++i];
    else if (arg === "--bridge-profile") out.bridgeProfile = argv[++i];
    else if (arg === "--help" || arg === "-h") return { help: true };
    else {
      process.stderr.write(`unknown argument: ${arg}\n`);
      return { error: true };
    }
  }
  return out;
}

async function main() {
  const args = parseArgs(process.argv.slice(2));
  if (args.help) {
    process.stdout.write(`${usage()}\n`);
    return 0;
  }
  if (args.error) {
    process.stderr.write(`${usage()}\n`);
    return 2;
  }
  if (args.command !== "init") {
    process.stderr.write(`${usage()}\n`);
    return 2;
  }

  const { initProjectmem } = await import("../src/projectmem/index.js");
  const { buildCoreClient, CoreClientError } = await import("../src/projectmem/core-client.js");

  const workspace = args.workspace ?? process.env.LAOS_CHECKPOINT_WORKSPACE;
  const project = args.project ?? process.env.LAOS_CHECKPOINT_PROJECT;
  if (!args.repoRoot || !args.repoKey || !args.component || !workspace || !project) {
    process.stderr.write("missing required arguments\n");
    return 2;
  }
  const confidentialityCeiling = args.confidentialityCeiling
    ?? process.env.LAOS_CHECKPOINT_CONFIDENTIALITY
    ?? (workspace === "work" ? "internal" : "personal");
  const bridgeProfile = args.bridgeProfile ?? "ws-gpt";

  const manifest = {
    schema: "laos-projectmem/v1",
    repo_key: args.repoKey,
    component: args.component,
    workspace,
    project,
    confidentiality_ceiling: confidentialityCeiling,
    bridge_profile: bridgeProfile,
    manifest_sha256: "",
  };
  const trustedProfile = {
    workspace,
    project,
    confidentiality_ceiling: confidentialityCeiling,
  };
  const client = buildCoreClient({ manifest, trustedProfile, env: process.env });
  let contextSha256 = "";
  let handles = [];
  try {
    contextSha256 = await client.contextSha256("project goals constraints decisions procedures current status");
    handles = await client.searchHandles();
  } catch (error) {
    if (error instanceof CoreClientError) {
      process.stderr.write(`core call failed (continuing with empty seed): ${error.message}\n`);
    } else {
      throw error;
    }
  }

  try {
    const result = await initProjectmem({
      repoRoot: args.repoRoot,
      repoKey: args.repoKey,
      component: args.component,
      workspace,
      project,
      confidentialityCeiling,
      bridgeProfile,
      contextSha256,
      handles,
      trustedProfile,
    });
    process.stdout.write(`${JSON.stringify(result, null, 2)}\n`);
    return 0;
  } catch (error) {
    process.stderr.write(`${JSON.stringify({ error: { code: error.code ?? "projectmem_failed", message: error.message } })}\n`);
    return 1;
  }
}

main().then((code) => process.exit(code));
